+#ifdef _WIN64
+/* ARM64: the 32-bit MCI parameter blocks start with a DWORD_PTR dwCallback, so they are
+ * not layout compatible with the 16-bit ones any more.  For the commands whose block is
+ * "dwCallback + 32-bit members" a widened copy is made: [16-bit block pointer][32-bit block]. */
+static DWORD mci_generic_extra(WORD wMsg)
+{
+    switch (wMsg) {
+    case MCI_PLAY:     return 12;
+    case MCI_SEEK:     return 4;
+    case MCI_SET:      return 48;
+    case MCI_GETDEVCAPS: return 8;
+    case MCI_RECORD:
+    case MCI_COPY:
+    case MCI_CUT:
+    case MCI_DELETE:
+    case MCI_PASTE:    return 28;
+    case MCI_CUE:
+    case MCI_STEP:
+    case MCI_SPIN:     return 4;
+    case MCI_SIGNAL:   return 12;
+    default:           return 0;
+    }
+}
+
+static DWORD_PTR mci_widen_generic(WORD wMsg, DWORD_PTR lParam16)
+{
+    DWORD *p16 = MapSL(lParam16);
+    DWORD extra = mci_generic_extra(wMsg);
+    char *base = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, 2 * sizeof(void *) + 8 + extra);
+    MCI_GENERIC_PARMS *p32;
+
+    if (!base) return 0;
+    *(DWORD **)base = p16;
+    p32 = (MCI_GENERIC_PARMS *)(base + sizeof(void *));
+    p32->dwCallback = (DWORD_PTR)HWND_32(p16[0]);
+    memcpy((char *)p32 + sizeof(DWORD_PTR), p16 + 1, extra);
+    return (DWORD_PTR)p32;
+}
+
+static void mci_narrow_generic(WORD wMsg, DWORD_PTR lParam32)
+{
+    char *base = (char *)lParam32 - sizeof(void *);
+    DWORD *p16 = *(DWORD **)base;
+
+    if (p16 && wMsg == MCI_GETDEVCAPS)
+        p16[1] = ((MCI_GETDEVCAPS_PARMS *)lParam32)->dwReturn;
+    HeapFree(GetProcessHeap(), 0, base);
+}
+#endif
