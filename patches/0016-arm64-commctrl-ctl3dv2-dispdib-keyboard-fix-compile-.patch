@@ -81,7 +81,7 @@ VOID WINAPI Enable16( FARPROC16 proc, LPBYTE lpKeyState )
  */
 VOID WINAPI Disable16(VOID)
 {
-    DefKeybEventProc = NULL;
+    DefKeybEventProc = 0;
     pKeyStateTable = NULL;
 }
 
