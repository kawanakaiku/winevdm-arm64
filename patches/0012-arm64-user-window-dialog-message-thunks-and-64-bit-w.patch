+/* This 16-bit code (executed by the emulator) pushes a 32-bit value only,
+ * so on 64-bit hosts it pushes the winproc handle and the real 32-bit
+ * window procedure is kept here. */
+#ifdef _WIN64
+static WNDPROC thunk_procs[MAX_WINPROCS16];
+static inline WNDPROC get_thunk_proc( UINT index )
+{
+    return index < MAX_WINPROCS16 ? thunk_procs[index] : NULL;
+}
+#else
+static inline WNDPROC get_thunk_proc( UINT index )
+{
+    return thunk_array[index].proc;
+}
+#endif
+
 /* return the window proc index for a given handle, or -1 for an invalid handle
