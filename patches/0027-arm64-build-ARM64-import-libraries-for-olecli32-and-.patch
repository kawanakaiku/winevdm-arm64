From 9bc93f8ec86e885555110336c43a98dfec0cce2e Mon Sep 17 00:00:00 2001
From: u <u@localhost>
Date: Sat, 7 Nov 2026 12:20:28 +0900
Subject: [PATCH] arm64: build ARM64 import libraries for olecli32 and olesvr32
 with llvm-dlltool

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 olecli/CMakeLists.txt     |  13 ++-
 olecli/olecli32_arm64.def | 180 ++++++++++++++++++++++++++++++++++++++
 olesvr/CMakeLists.txt     |  13 ++-
 olesvr/olesvr32_arm64.def |  25 ++++++
 4 files changed, 229 insertions(+), 2 deletions(-)
 create mode 100644 olecli/olecli32_arm64.def
 create mode 100644 olesvr/olesvr32_arm64.def

diff --git a/olecli/CMakeLists.txt b/olecli/CMakeLists.txt
index 2e01d571..10bba3db 100644
--- a/olecli/CMakeLists.txt
+++ b/olecli/CMakeLists.txt
@@ -3,5 +3,16 @@ add_library(olecli SHARED ${SOURCE} ${CMAKE_CURRENT_BINARY_DIR}/olecli.def olecl
 include_directories(../wine)
 add_definitions(-D__WINESRC__ -DHAVE_STRNCASECMP -DHAVE__STRNICMP -D_WINTERNL_ -DNtCurrentTeb=NtCurrentTeb__ -DDECLSPEC_HIDDEN= -Dstrncasecmp=_strnicmp)
 spec_build(olecli.dll16 olecli)
-target_link_libraries(olecli libwine winecrt0 krnl386 olecli32)
+if (WINEVDM_ARM64 AND NOT(MSVC))
+    # llvm-mingw has no ARM64 import library for olecli32
+    find_program(LLVM_DLLTOOL llvm-dlltool REQUIRED)
+    add_custom_command(OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/libolecli32.a
+        COMMAND ${LLVM_DLLTOOL} -m arm64 -d ${CMAKE_CURRENT_SOURCE_DIR}/olecli32_arm64.def -l ${CMAKE_CURRENT_BINARY_DIR}/libolecli32.a
+        DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/olecli32_arm64.def)
+    add_custom_target(olecli32_implib DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/libolecli32.a)
+    add_dependencies(olecli olecli32_implib)
+    target_link_libraries(olecli libwine winecrt0 krnl386 ${CMAKE_CURRENT_BINARY_DIR}/libolecli32.a)
+else()
+    target_link_libraries(olecli libwine winecrt0 krnl386 olecli32)
+endif()
 set_target_properties(olecli PROPERTIES SUFFIX ".dll16")
