 lzexpand/wine_lzexpand.c |  4 ++--
 mmsystem/driver.c        | 10 ++++++++++
 mmsystem/mci16.c         |  6 +++++-
 mmsystem/mmio16.c        |  6 +++++-
 mmsystem/mmsystem.c      |  6 +++++-
 mmsystem/playsound.c     |  6 +++++-
 mmsystem/winemm16.h      | 10 ++++++++++
 msacm/wineacm16.h        | 10 ++++++++++
 msvideo/msvideo16.c      | 16 +++++++++++++++-
 13 files changed, 85 insertions(+), 19 deletions(-)

diff --git a/commdlg/filedlg.c b/commdlg/filedlg.c
index 8a6d083e..da183747 100644
--- a/commdlg/filedlg.c
+++ b/commdlg/filedlg.c
@@ -312,7 +312,7 @@ BOOL16 WINAPI GetOpenFileName16( SEGPTR ofn ) /* [in/out] address of structure w
     OPENFILENAMEA ofn32;
     BOOL ret;
     DWORD count;
-    WORD res = NULL;
+    WORD res = 0;
 
     if (!lpofn) return FALSE;
     OPENFILENAME16 ofn16 = *lpofn;
@@ -407,7 +407,7 @@ BOOL16 WINAPI GetSaveFileName16( SEGPTR ofn ) /* [in/out] address of structure w
     OPENFILENAMEA ofn32;
     BOOL ret;
     DWORD count;
-    WORD res = NULL;
+    WORD res = 0;
 
     if (!lpofn) return FALSE;
     OPENFILENAME16 ofn16 = *lpofn;
diff --git a/commdlg/finddlg.c b/commdlg/finddlg.c
index 5dc9cd0e..e47d7d16 100644
--- a/commdlg/finddlg.c
+++ b/commdlg/finddlg.c
@@ -100,7 +100,7 @@ static INT_PTR CALLBACK find_text_dlgproc(HWND hWnd, UINT wMsg, WPARAM wParam, L
          * FindNext (IDOK) button.  Only after typing some text, the button should be
          * enabled.
          */
-        SetDlgItemTextA(hWnd, edt1, lpfr->lpstrFindWhat);
+        SetDlgItemTextA(hWnd, edt1, MapSL(lpfr->lpstrFindWhat));
         CheckRadioButton(hWnd, rad1, rad2, (lpFlags & FR_DOWN) ? rad2 : rad1);
         if (lpFlags & (FR_HIDEUPDOWN | FR_NOUPDOWN)) {
             EnableWindow(GetDlgItem(hWnd, rad1), FALSE);
@@ -162,7 +162,7 @@ HWND16 WINAPI FindText16( SEGPTR find )
             template = resource_to_dialog32(fr16->hInstance, MapSL(fr16->lpTemplateName), NULL);
         else
             template = handle_to_dialog32(fr16->hInstance, NULL);
-        ret = HWND_16(CreateDialogIndirectParamA(fr16->hInstance, template,
+        ret = HWND_16(CreateDialogIndirectParamA(NULL /* FIXME ARM64: was the 16-bit hInstance */, template,
                                 HWND_32(fr16->hwndOwner), find_text_dlgproc, find));
         HeapFree(GetProcessHeap(), 0, template);
     }
@@ -282,8 +282,8 @@ static INT_PTR CALLBACK replace_text_dlgproc(HWND hWnd, UINT wMsg, WPARAM wParam
          * Replace / ReplaceAll buttons.  Only after typing some text, the buttons should be
          * enabled.
          */
-        SetDlgItemTextA(hWnd, edt1, lpfr->lpstrFindWhat);
-        SetDlgItemTextA(hWnd, edt2, lpfr->lpstrReplaceWith);
+        SetDlgItemTextA(hWnd, edt1, MapSL(lpfr->lpstrFindWhat));
+        SetDlgItemTextA(hWnd, edt2, MapSL(lpfr->lpstrReplaceWith));
         CheckDlgButton(hWnd, chx1, (lpFlags & FR_WHOLEWORD) ? 1 : 0);
         if (lpFlags & (FR_HIDEWHOLEWORD | FR_NOWHOLEWORD))
             EnableWindow(GetDlgItem(hWnd, chx1), FALSE);
@@ -337,7 +337,7 @@ HWND16 WINAPI ReplaceText16( SEGPTR find )
             template = resource_to_dialog32(fr16->hInstance, MapSL(fr16->lpTemplateName), NULL);
         else
             template = handle_to_dialog32(fr16->hInstance, NULL);
-        ret = HWND_16(CreateDialogIndirectParamA(fr16->hInstance, template,
+        ret = HWND_16(CreateDialogIndirectParamA(NULL /* FIXME ARM64: was the 16-bit hInstance */, template,
                                 HWND_32(fr16->hwndOwner), replace_text_dlgproc, find));
         HeapFree(GetProcessHeap(), 0, template);
     }
diff --git a/commdlg/printdlg.c b/commdlg/printdlg.c
index 85c56419..1bcfff28 100644
--- a/commdlg/printdlg.c
+++ b/commdlg/printdlg.c
@@ -164,7 +164,8 @@ LPDLGTEMPLATEA resource_to_dialog32(HINSTANCE16 hInst, LPCSTR name, WORD *res)
     if (!res)
         FreeResource16(handle);
     else
-        res = ptr16;
+        /* FIXME ARM64: upstream assigns the local pointer (no effect); keep that */
+        (void)ptr16;
     return r;
 }
 
@@ -172,11 +173,12 @@ LPDLGTEMPLATEA handle_to_dialog32(HGLOBAL16 hg, WORD *res)
 {
     DWORD size2;
     SEGPTR ptr16 = WOWGlobalLock16(hg);
-    LPDLGTEMPLATEA r = dialog_template16_to_template32(NULL, ptr16, &size2, NULL);
+    LPDLGTEMPLATEA r = dialog_template16_to_template32(0, ptr16, &size2, NULL);
     if (!res)
         WOWGlobalUnlock16(hg);
     else
-        res = ptr16;
+        /* FIXME ARM64: upstream assigns the local pointer (no effect); keep that */
+        (void)ptr16;
     return r;
 }
 
diff --git a/ddeml/ddeml.c b/ddeml/ddeml.c
index 192b8c95..3f7dccdd 100644
--- a/ddeml/ddeml.c
+++ b/ddeml/ddeml.c
@@ -173,7 +173,11 @@ static CRITICAL_SECTION_DEBUG critsect_debug =
 {
     0, 0, &ddeml_cs,
     { &critsect_debug.ProcessLocksList, &critsect_debug.ProcessLocksList },
-      0, 0, { (DWORD_PTR)(__FILE__ ": ddeml_cs") }
+#ifdef _WIN64
+        0, 0, { 0 } /* Spare is a DWORD on 64-bit */
+#else
+        0, 0, { (DWORD_PTR)(__FILE__ ": ddeml_cs") }
+#endif
 };
 static CRITICAL_SECTION ddeml_cs = { &critsect_debug, -1, 0, 0, 0, 0 };
 
@@ -417,7 +421,7 @@ HSZ WINAPI DdeCreateStringHandle16(DWORD idInst, LPCSTR str, INT16 codepage)
         else
         {
             ERR("Invalid codepage %x\n", codepage);
-            return DMLERR_INVALIDPARAMETER;
+            return (HSZ)(ULONG_PTR)DMLERR_INVALIDPARAMETER;
         }
     }
     if (str && !stricmp(str, "Progman"))
diff --git a/lzexpand/wine_lzexpand.c b/lzexpand/wine_lzexpand.c
index 4da44f7c..9f2f00f2 100644
--- a/lzexpand/wine_lzexpand.c
+++ b/lzexpand/wine_lzexpand.c
@@ -572,8 +572,8 @@ void WINAPI LZClose( HFILE fd )
         {
             HeapFree( GetProcessHeap(), 0, lzs->get );
             lzstates[fd - LZ_MIN_HANDLE] = NULL;
-            if (DeleteDosFileHandle(lzs->realfd))
-                CloseHandle(lzs->realfd);
+            if (DeleteDosFileHandle(LongToHandle(lzs->realfd)))
+                CloseHandle(LongToHandle(lzs->realfd));
             HeapFree( GetProcessHeap(), 0, lzs );
         }
 }
