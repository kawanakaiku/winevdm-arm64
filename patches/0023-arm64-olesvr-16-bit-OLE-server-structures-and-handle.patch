 {
     BOOL block32 = *block;
-    OLESTATUS status = OleUnblockServer(hServer, &block32);
+    OLESTATUS status = OleUnblockServer((LHSERVER)hServer, &block32);
     *block = block32;
     return status;
 }
 /***********************************************************************
  *		OleRegisterServerDoc	[OLESVR.6]
  */
-OLESTATUS WINAPI OleRegisterServerDoc16( LHSERVER hServer, LPCSTR docname,
+OLESTATUS WINAPI OleRegisterServerDoc16( LONG hServer, LPCSTR docname,
                                          SEGPTR document,
-                                         LHSERVERDOC *hRet)
+                                         LONG /* LHSERVERDOC16 */ *hRet)
 {
     LPOLESERVERDOC doc32 = register_oleserver_doc(document);
-    OLESTATUS result = OleRegisterServerDoc(hServer, docname, doc32, hRet);
+    LHSERVERDOC h = 0;
+    OLESTATUS result = OleRegisterServerDoc((LHSERVER)hServer, docname, doc32, &h);
+    *hRet = (LONG)h; /* FIXME ARM64: assumes the 32-bit handle fits in a LONG */
     return result;
 }
 
 /******************************************************************************
  *		OleRevokeServerDoc	[OLESVR.7]
  */
-OLESTATUS WINAPI OleRevokeServerDoc16(LHSERVERDOC hServerDoc)
+OLESTATUS WINAPI OleRevokeServerDoc16(LONG hServerDoc)
 {
-    return OleRevokeServerDoc(hServerDoc);
+    return OleRevokeServerDoc((LHSERVERDOC)hServerDoc);
 }
 
 /******************************************************************************
