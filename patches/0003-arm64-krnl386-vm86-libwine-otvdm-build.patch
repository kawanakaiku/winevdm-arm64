+#ifdef __aarch64__
+/***********************************************************************
+ *           relay_get_args64
+ *
+ * Build the native arguments of a 16-bit entry point from the argument
+ * types of its CALLFROM16 structure.  Returns the number of arguments.
+ */
+static int relay_get_args64( const CALLFROM16 *call, unsigned char *args16, CONTEXT86 *context, ULONG_PTR *args64 )
+{
+    unsigned int i, j, nb_args = 0;
+
+    /* look for the ret instruction */
+    for (j = 0; j < ARRAY_SIZE(call->ret); j++)
+        if (call->ret[j] == 0xca || call->ret[j] == 0xcb) break;
+
+    if (call->ret[j] == 0xcb)  /* cdecl */
+    {
+        for (i = 0; i < 20; i++, nb_args++)
+        {
+            int type = (call->arg_types[i / 10] >> (3 * (i % 10))) & 7;
+
+            if (type == ARG_NONE) break;
+            switch(type)
+            {
+            case ARG_WORD:   args64[nb_args] = *(WORD *)args16; args16 += sizeof(WORD); break;
