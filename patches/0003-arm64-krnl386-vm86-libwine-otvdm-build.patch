+ULONG_PTR call_entry_point64( void *func, int nb_args, const ULONG_PTR *args )
+{
+    typedef ULONG_PTR (WINAPI *func32_t)( ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR,
+                                          ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR,
+                                          ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR,
+                                          ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR );
+    ULONG_PTR a[32] = { 0 };
+
+    if (nb_args > 32)
+    {
+        ERR( "too many arguments (%d) for %p\n", nb_args, func );
+        nb_args = 32;
+    }
+    if (nb_args > 0) memcpy( a, args, nb_args * sizeof(a[0]) );
+    return ((func32_t)func)( a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7],
+                             a[8], a[9], a[10], a[11], a[12], a[13], a[14], a[15],
+                             a[16], a[17], a[18], a[19], a[20], a[21], a[22], a[23],
+                             a[24], a[25], a[26], a[27], a[28], a[29], a[30], a[31] );
+}
+
+/* 32-bit arguments are sign extended (LONG, handles such as (HANDLE)-1);
+ * flat pointers passed this way must be below 2GB. */
+int call_entry_point( void *func, int nb_args, const int *args )
+{
+    ULONG_PTR a[32];
+    int i;
+
+    if (nb_args > 32) nb_args = 32;
+    for (i = 0; i < nb_args; i++) a[i] = (ULONG_PTR)(LONG_PTR)args[i];
+    return (int)call_entry_point64( func, nb_args, a );
+}
