 #include "wine/exception.h"
 #include "wine/debug.h"
 #include "winuser.h"
@@ -93,18 +94,45 @@ static inline void patch_code_segment( NE_MODULE *pModule )
 
     call = GlobalLock16( pSeg->hSeg );
 
+#ifdef _WIN64
+    {
+        /* convspec stores image relative addresses on 64-bit hosts (see
+         * output_code16_pushl), add the base of the 32-bit module */
+        DWORD base = (DWORD)(ULONG_PTR)pModule->owner32;
+        BYTE *p, *end = (BYTE *)call + GlobalSize16( pSeg->hSeg );
+
+        if ((ULONG_PTR)pModule->owner32 >> 32)
+            ERR( "module %p is above 4GB, 16-bit entry points will not work\n", pModule->owner32 );
+        for (i = 0; call[i].pushl == 0x6866; i++) call[i].relay += base;
+        /* entry points: [pushw %bp] [stack prolog] pushl $target, callw callfrom16 */
+        p = (BYTE *)&call[i];
+        while (p + 10 <= end && p[0] == 0x55)
+        {
+            p++;
+            if (p[0] == 0x89) p += 8;  /* movw %sp,%bp; pushw $0x1234; popw %bp; popw %bp; pushw %bp */
+            if (p[0] != 0x66 || p[1] != 0x68) break;
+            *(DWORD *)(p + 2) += base;
+            p += 6;
+            if (p[0] != 0xe8) break;
+            p += 3;
+        }
+    }
+#endif
+
     /* patch glue code address and code selector */
     for (i = 0; call[i].pushl == 0x6866; i++)
     {
         if (call[i].ret[0] == 0xca || call[i].ret[0] == 0xcb)  /* register entry point? */
-            call[i].glue = __wine_call_from_16_regs;
+            call[i].glue = (DWORD)(ULONG_PTR)__wine_call_from_16_regs;
         else
-            call[i].glue = __wine_call_from_16;
+            call[i].glue = (DWORD)(ULONG_PTR)__wine_call_from_16;
         call[i].flatcs = wine_get_cs();
     }
 
+#ifndef _WIN64  /* on 64-bit hosts relay_call_from_16 traces and calls the typed relays */
     if (TRACE_ON(relay))  /* patch relay functions to all point to relay_call_from_16 */
         for (i = 0; call[i].pushl == 0x6866; i++) call[i].relay = relay_call_from_16;
+#endif
 }
 
 
