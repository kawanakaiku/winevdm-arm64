+    /* 16-bit stack offset of each argument */
+    pos = (odp->type == TYPE_PASCAL) ? argsize : 0;
+    for (i = 0; i < nb_args; i++)
+    {
+        int size = get_arg16_size( odp->u.func.args[i] );
+        if (odp->type == TYPE_PASCAL)
+        {
+            pos -= size;
+            offsets[i] = pos;
+        }
+        else
+        {
+            offsets[i] = pos;
+            pos += size;
+        }
+    }
+
+    /* count the arguments passed on the stack */
+    for (i = 0; i < nb_args + has_extra; i++)
+    {
+        int is_fp = i < nb_args && (odp->u.func.args[i] == ARG_FLOAT || odp->u.func.args[i] == ARG_DOUBLE);
+        if (is_fp) { if (nb_freg < 8) nb_freg++; else nb_stack++; }
+        else { if (nb_ireg < 8) nb_ireg++; else nb_stack++; }
+    }
+    stack_size = (nb_stack * 8 + 15) & ~15;
