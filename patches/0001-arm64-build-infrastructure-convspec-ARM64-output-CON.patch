diff --git a/CMakeLists.txt b/CMakeLists.txt
index cf545504..f9a91fb2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -2,6 +2,15 @@ cmake_minimum_required(VERSION 3.10.2)
 #-Dinline=__inline
 project(winevdm)
 set(ASM_TOOL_DIR )
+
+# ARM64 (aarch64-windows) build: the 16-bit side is still run by the
+# vm86 CPU emulator, only the 32-bit side becomes native ARM64 code.
+if (CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|ARM64|arm64)$")
+    set(WINEVDM_ARM64 ON)
+else()
+    set(WINEVDM_ARM64 OFF)
+endif()
+
 # prevent wine error
 if (NOT(MSVC))
     string(APPEND CMAKE_CXX_FLAGS " -Wno-narrowing ")
@@ -9,6 +18,32 @@ else()
     add_definitions(-DUSE_COMPILER_EXCEPTIONS -Dinline=__inline)
 endif()
 
+if (WINEVDM_ARM64)
+    set(WINEVDM_ARCH_DEFS -DWINEVDM_ARM64)
+    set(CONVSPEC_ARCH --arm64)
+    if (NOT(MSVC))
+        add_definitions(-DUSE_COMPILER_EXCEPTIONS)
+        string(APPEND CMAKE_C_FLAGS " -fms-extensions -Wno-int-to-pointer-cast -Wno-pointer-to-int-cast")
+        string(APPEND CMAKE_CXX_FLAGS " -fms-extensions")
+        # keep every image below 4GB: 16-bit code holds 32-bit flat pointers
+        # to 32-bit side functions (relay entry points, thunks, window procs)
+        string(APPEND CMAKE_SHARED_LINKER_FLAGS " -static -Wl,--disable-high-entropy-va")
+        string(APPEND CMAKE_EXE_LINKER_FLAGS " -static -Wl,--disable-high-entropy-va -Wl,--image-base=0x400000")
+    endif()
+else()
+    set(WINEVDM_ARCH_DEFS -D_X86_ -D__i386__)
+    set(CONVSPEC_ARCH )
+endif()
+add_definitions(${WINEVDM_ARCH_DEFS})
+
+if (NOT DEFINED SPEC_AS)
+    if (WINEVDM_ARM64)
+        set(SPEC_AS ${CMAKE_C_COMPILER} -c -x assembler)
+    else()
+        set(SPEC_AS ${ASM_TOOL_DIR}as --32)
+    endif()
+endif()
+
 set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR})
 set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR})
 set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR})
@@ -16,14 +51,14 @@ macro(def_file_build32 file)
     get_filename_component(name_we ${file} NAME_WE)
     add_custom_command(OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${name_we}.def
     DEPENDS ${file}.spec convspec
-    COMMAND convspec ${CMAKE_CURRENT_LIST_DIR}/${file}.spec -DEF -32 > ${CMAKE_CURRENT_BINARY_DIR}/${name_we}.def)
+    COMMAND convspec ${CMAKE_CURRENT_LIST_DIR}/${file}.spec -DEF -32 ${CONVSPEC_ARCH} > ${CMAKE_CURRENT_BINARY_DIR}/${name_we}.def)
     add_custom_target(generate_def_${name_we} DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/${name_we}.def)
 endmacro()
 macro(def_file_build file)
     get_filename_component(name_we ${file} NAME_WE)
     add_custom_command(OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${name_we}.def
     DEPENDS ${file}.spec convspec
-    COMMAND convspec ${CMAKE_CURRENT_LIST_DIR}/${file}.spec -DEF > ${CMAKE_CURRENT_BINARY_DIR}/${name_we}.def)
+    COMMAND convspec ${CMAKE_CURRENT_LIST_DIR}/${file}.spec -DEF ${CONVSPEC_ARCH} > ${CMAKE_CURRENT_BINARY_DIR}/${name_we}.def)
     add_custom_target(generate_def_${name_we} DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/${name_we}.def)
 endmacro()
 macro(spec_build file modname)
@@ -32,7 +67,8 @@ macro(spec_build file modname)
     cmake_parse_arguments(SPEC_BUILD "" "" "ARG" ${ARGN})
     add_custom_command(OUTPUT ${file}.obj ${file}.asm
     DEPENDS ${file}.spec convspec
-    COMMAND convspec ${CMAKE_CURRENT_LIST_DIR}/${file}.spec ${SPEC_BUILD_ARG} ${modname} > ${file}.asm && ${ASM_TOOL_DIR}as --32 -o ${file}.obj ${file}.asm)
+    COMMAND convspec ${CMAKE_CURRENT_LIST_DIR}/${file}.spec ${SPEC_BUILD_ARG} ${CONVSPEC_ARCH} ${modname} > ${file}.asm
+    COMMAND ${SPEC_AS} -o ${file}.obj ${file}.asm)
     add_custom_target(generate_asm_${name_we} DEPENDS ${file}.obj)
     if (MSVC)
         set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} /SAFESEH:NO")
@@ -46,7 +82,8 @@ macro(widl_build file_idl file_c file_h)
     get_filename_component(name_we ${file_idl} NAME_WE)
     add_custom_command(OUTPUT ${file_c} ${file_h}
     DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/${file_idl} widl
-    COMMAND $<TARGET_FILE_DIR:widl>/widl.exe ${CMAKE_CURRENT_SOURCE_DIR}/${file_idl} -o ${file_c} && $<TARGET_FILE_DIR:widl>/widl.exe ${CMAKE_CURRENT_SOURCE_DIR}/${file_idl} -o ${file_h}
+    COMMAND $<TARGET_FILE:widl> ${CMAKE_CURRENT_SOURCE_DIR}/${file_idl} -o ${file_c}
+    COMMAND $<TARGET_FILE:widl> ${CMAKE_CURRENT_SOURCE_DIR}/${file_idl} -o ${file_h}
 WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR})
     add_custom_target(generate_ifs_${name_we} DEPENDS ${file_c} ${file_h})
 endmacro()
