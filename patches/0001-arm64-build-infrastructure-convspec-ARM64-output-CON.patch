+/*******************************************************************
+ *         16-bit code output helpers
+ *
+ * On ARM64 the 16-bit code segment is plain data for the assembler
+ * (it is only ever run by the vm86 CPU emulator), so the x86-16
+ * instructions are written as bytes.  32-bit flat addresses embedded
+ * in it are written as image relative values (.rva) because lld does
+ * not emit base relocations for 32-bit absolute values on ARM64;
+ * krnl386 adds the image base when it patches the code segment.
+ */
+static inline int code16_as_bytes(void)
+{
+    return target_cpu != CPU_x86;
+}
+
+static void output_code16_pushl( const char *sym )
+{
+    if (!code16_as_bytes()) output( "\tpushl $%s\n", sym );
+    else output( "\t.byte 0x66,0x68\n\t.rva %s\n", sym );
+}
+
+static void output_code16_insn( const char *insn, const char *bytes )
+{
+    if (!code16_as_bytes()) output( "\t%s\n", insn );
+    else output( "\t.byte %s\n", bytes );
+}
+
+static void output_code16_lretw( int argsize )
+{
+    if (!code16_as_bytes())
+    {
+        if (argsize) output( "\tlretw $%u\n", argsize );
+        else output( "\tlretw\n" );
+    }
+    else
+    {
+        if (argsize) output( "\t.byte 0xca,0x%02x,0x%02x\n", argsize & 0xff, (argsize >> 8) & 0xff );
+        else output( "\t.byte 0xcb\n" );
+    }
+}
+
+static void output_code16_callw( const char *label )
+{
+    if (!code16_as_bytes()) output( "\tcallw %s\n", label );
+    else output( "\t.byte 0xe8\n\t.short %s-(.+2)\n", label );
+}
+
 static inline int is_function( const ORDDEF *odp )
 {
     if (odp->flags & FLAG_EXPORT32) return 0;
@@ -451,6 +498,180 @@ static void output_call16_function( ORDDEF *odp )
