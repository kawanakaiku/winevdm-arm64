+/*******************************************************************
+ *         output_call16_function_arm64
+ *
+ * ARM64 version of output_call16_function: fetch the 16-bit arguments
+ * from 'args' (x1) and call 'func' (x0) with the native calling
+ * convention; register functions also get the CONTEXT pointer (x2),
+ * varargs functions get a pointer to the remaining 16-bit arguments.
+ */
+static int get_arg16_size( int type )
+{
+    switch (type)
+    {
+    case ARG_WORD:
+    case ARG_SWORD:
+        return 2;
+    case ARG_INT64:
+    case ARG_DOUBLE:
+        return 8;
+    default:
+        return 4;
+    }
+}
+
+static void output_arm64_store_arg( int is_fp, int is_double, int *ireg, int *freg, int *slot )
+{
+    if (is_fp)
+    {
+        if (*freg < 8)
+        {
+            output( "\tfmov %c%d, %c9\n", is_double ? 'd' : 's', (*freg)++, is_double ? 'x' : 'w' );
+            return;
+        }
+    }
+    else if (*ireg < 8)
+    {
+        output( "\tmov x%d, x9\n", (*ireg)++ );
+        return;
+    }
+    output( "\tstr x9, [sp, #%d]\n", 8 * (*slot)++ );
+}
+
+static void output_call16_function_arm64( ORDDEF *odp )
+{
+    char *name;
+    int i, pos, nb_args = odp->u.func.nb_args;
+    int argsize = get_function_argsize( odp );
+    int offsets[MAX_ARGUMENTS];
+    int nb_ireg = 0, nb_freg = 0, nb_stack = 0, stack_size;
+    int ireg = 0, freg = 0, slot = 0;
