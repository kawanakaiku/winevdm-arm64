+    for (i = 0; i < nb_args; i++)
+    {
+        int off = offsets[i];
+        switch (odp->u.func.args[i])
+        {
+        case ARG_WORD:
+            output( "\tldrh w9, [x20, #%d]\n", off );
+            output_arm64_store_arg( 0, 0, &ireg, &freg, &slot );
+            break;
+        case ARG_SWORD:
+            output( "\tldrsh x9, [x20, #%d]\n", off );
+            output_arm64_store_arg( 0, 0, &ireg, &freg, &slot );
+            break;
+        case ARG_LONG:
