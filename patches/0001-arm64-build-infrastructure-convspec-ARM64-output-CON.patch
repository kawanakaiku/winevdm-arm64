+    name = strmake( "__wine_spec_call16_%s", get_relay_name(odp) );
+    output( "\t.p2align 2\n" );
+    output( "\t.def %s; .scl 3; .type 32; .endef\n", name );
+    output( ".L%s:\n", name );
+    output( "%s:\n", name );
+    output( "\t.seh_proc %s\n", name );
+    output( "\tstp x29, x30, [sp, #-32]!\n" );
+    output( "\t.seh_save_fplr_x 32\n" );
+    output( "\tstp x19, x20, [sp, #16]\n" );
+    output( "\t.seh_save_regp x19, 16\n" );
+    output( "\tmov x29, sp\n" );
+    output( "\t.seh_set_fp\n" );
+    output( "\t.seh_endprologue\n" );
+    output( "\tmov x19, x0\n" );  /* func */
+    output( "\tmov x20, x1\n" );  /* args */
+    output( "\tmov x15, x2\n" );  /* context */
+    if (stack_size) output( "\tsub sp, sp, #%d\n", stack_size );
+    if (needs_ldt)
