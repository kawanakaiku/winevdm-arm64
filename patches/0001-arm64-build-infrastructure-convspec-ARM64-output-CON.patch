diff --git a/wine/wine/context86.h b/wine/wine/context86.h
new file mode 100644
index 00000000..97e1bc7a
--- /dev/null
+++ b/wine/wine/context86.h
@@ -0,0 +1,39 @@
+/*
+ * x86 register context used for the 16-bit (vm86 emulator) side.
+ *
+ * On 32-bit x86 hosts this is the native CONTEXT; on 64-bit hosts
+ * (ARM64) it is the x86 layout, i.e. WOW64_CONTEXT.
+ */
+#ifndef __WINE_CONTEXT86_H
+#define __WINE_CONTEXT86_H
+
+#include <windef.h>
+#include <winnt.h>
+
+#ifdef _WIN64
+typedef WOW64_CONTEXT CONTEXT86, *PCONTEXT86;
+typedef WOW64_FLOATING_SAVE_AREA FLOATING_SAVE_AREA86;
+#define CONTEXT86_i386               WOW64_CONTEXT_i386
+#define CONTEXT86_CONTROL            WOW64_CONTEXT_CONTROL
+#define CONTEXT86_INTEGER            WOW64_CONTEXT_INTEGER
+#define CONTEXT86_SEGMENTS           WOW64_CONTEXT_SEGMENTS
+#define CONTEXT86_FLOATING_POINT     WOW64_CONTEXT_FLOATING_POINT
+#define CONTEXT86_DEBUG_REGISTERS    WOW64_CONTEXT_DEBUG_REGISTERS
+#define CONTEXT86_EXTENDED_REGISTERS WOW64_CONTEXT_EXTENDED_REGISTERS
+#define CONTEXT86_FULL               WOW64_CONTEXT_FULL
+#define CONTEXT86_ALL                WOW64_CONTEXT_ALL
+#else
+typedef CONTEXT CONTEXT86, *PCONTEXT86;
+typedef FLOATING_SAVE_AREA FLOATING_SAVE_AREA86;
+#define CONTEXT86_i386               CONTEXT_i386
+#define CONTEXT86_CONTROL            CONTEXT_CONTROL
+#define CONTEXT86_INTEGER            CONTEXT_INTEGER
+#define CONTEXT86_SEGMENTS           CONTEXT_SEGMENTS
+#define CONTEXT86_FLOATING_POINT     CONTEXT_FLOATING_POINT
+#define CONTEXT86_DEBUG_REGISTERS    CONTEXT_DEBUG_REGISTERS
+#define CONTEXT86_EXTENDED_REGISTERS CONTEXT_EXTENDED_REGISTERS
+#define CONTEXT86_FULL               CONTEXT_FULL
+#define CONTEXT86_ALL                CONTEXT_ALL
+#endif
+
+#endif /* __WINE_CONTEXT86_H */
