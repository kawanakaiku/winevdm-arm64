-add_subdirectory(convspec)
+if (NOT CMAKE_CROSSCOMPILING)
+    add_subdirectory(convspec)
+endif()
 add_subdirectory(winecrt0)
 add_subdirectory(wow32)
 add_subdirectory(krnl386)
@@ -78,7 +126,9 @@ add_subdirectory(ctl3dv2)
 add_subdirectory(ddeml)
 add_subdirectory(dispdib)
 add_subdirectory(display)
-add_subdirectory(haxmvm)
+if (NOT WINEVDM_ARM64)
+    add_subdirectory(haxmvm)
+endif()
 add_subdirectory(keyboard)
 add_subdirectory(lzexpand)
 add_subdirectory(mmsystem)
@@ -103,7 +153,9 @@ add_subdirectory(timer)
 add_subdirectory(toolhelp)
 add_subdirectory(typelib)
 add_subdirectory(ver)
-add_subdirectory(widl)
+if (NOT CMAKE_CROSSCOMPILING)
+    add_subdirectory(widl)
+endif()
 add_subdirectory(wifeman)
 add_subdirectory(wing)
 add_subdirectory(winhlp32)
@@ -111,10 +163,33 @@ add_subdirectory(winnls)
 add_subdirectory(winoldap)
 add_subdirectory(winsock)
 add_subdirectory(winspool)
-add_subdirectory(wpp)
+if (NOT CMAKE_CROSSCOMPILING)
+    add_subdirectory(wpp)
+endif()
 add_subdirectory(otvdm)
-add_subdirectory(gvm)
+if (NOT WINEVDM_ARM64)
+    add_subdirectory(gvm)
+endif()
 add_subdirectory(ntvdm)
-if (HAVE_WINHVPLATFORM_H)
+if (HAVE_WINHVPLATFORM_H AND NOT WINEVDM_ARM64)
   add_subdirectory(whpxvm)
 endif()
+
+# ARM64: give every DLL its own fixed base address below 2GB, so that
+# the flat 32-bit addresses seen by the 16-bit side are valid without
+# relocation (relocations are kept, the loader keeps them below 4GB).
+if (WINEVDM_ARM64 AND NOT(MSVC))
+    set(WINEVDM_IMAGE_BASE 268435456) # 0x10000000
+    get_property(WINEVDM_SUBDIRS DIRECTORY ${CMAKE_SOURCE_DIR} PROPERTY SUBDIRECTORIES)
+    foreach(dir IN LISTS WINEVDM_SUBDIRS)
+        get_property(targets DIRECTORY ${dir} PROPERTY BUILDSYSTEM_TARGETS)
+        foreach(t IN LISTS targets)
+            get_target_property(type ${t} TYPE)
+            if (type STREQUAL "SHARED_LIBRARY")
+                math(EXPR base "${WINEVDM_IMAGE_BASE}" OUTPUT_FORMAT HEXADECIMAL)
+                set_property(TARGET ${t} APPEND_STRING PROPERTY LINK_FLAGS " -Wl,--image-base=${base}")
+                math(EXPR WINEVDM_IMAGE_BASE "${WINEVDM_IMAGE_BASE} + 16777216")
+            endif()
+        endforeach()
+    endforeach()
+endif()
