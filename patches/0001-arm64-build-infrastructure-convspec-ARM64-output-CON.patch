+    if (odp->flags & FLAG_REGISTER)
+    {
+        output( "\tmov x9, x15\n" );
+        output_arm64_store_arg( 0, 0, &ireg, &freg, &slot );
+    }
+    else if (odp->type == TYPE_VARARGS)
+    {
+        output( "\tadd x9, x20, #%d\n", argsize );
+        output_arm64_store_arg( 0, 0, &ireg, &freg, &slot );
+    }
+
+    output( "\tblr x19\n" );
+    output( "\t.seh_startepilogue\n" );
+    output( "\tmov sp, x29\n" );
+    output( "\t.seh_set_fp\n" );
+    output( "\tldp x19, x20, [sp, #16]\n" );
+    output( "\t.seh_save_regp x19, 16\n" );
+    output( "\tldp x29, x30, [sp], #32\n" );
+    output( "\t.seh_save_fplr_x 32\n" );
+    output( "\t.seh_endepilogue\n" );
+    output( "\tret\n" );
+    output( "\t.seh_endproc\n" );
+    free( name );
+}
