+            break;
+        case ARG_SEGPTR:
+        case ARG_SEGSTR:
+            output( "\tldr w9, [x20, #%d]\n", off );
+            output_arm64_store_arg( 0, 0, &ireg, &freg, &slot );
+            break;
+        case ARG_FLOAT:
+            output( "\tldr w9, [x20, #%d]\n", off );
+            output_arm64_store_arg( 1, 0, &ireg, &freg, &slot );
+            break;
+        case ARG_DOUBLE:
+            output( "\tldr x9, [x20, #%d]\n", off );
+            output_arm64_store_arg( 1, 1, &ireg, &freg, &slot );
+            break;
+        case ARG_INT64:
+            output( "\tldr x9, [x20, #%d]\n", off );
+            output_arm64_store_arg( 0, 0, &ireg, &freg, &slot );
+            break;
+        case ARG_PTR:
+        case ARG_STR:
+        case ARG_WSTR:
+        case ARG_INT128:
+            output( "\tldrh w10, [x20, #%d]\n", off + 2 );  /* selector */
+            output( "\tldrh w9, [x20, #%d]\n", off );       /* offset */
+            output( "\tlsr w10, w10, #3\n" );
+            output( "\tldr x10, [x11, x10, lsl #3]\n" );
+            output( "\tadd x9, x10, x9\n" );
