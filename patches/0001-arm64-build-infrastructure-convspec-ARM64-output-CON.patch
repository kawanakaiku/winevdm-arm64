+    add_executable(convspec IMPORTED GLOBAL)
+    set_property(TARGET convspec PROPERTY IMPORTED_LOCATION ${HOST_CONVSPEC})
+    add_executable(widl IMPORTED GLOBAL)
+    set_property(TARGET widl PROPERTY IMPORTED_LOCATION ${HOST_WIDL})
+endif()
