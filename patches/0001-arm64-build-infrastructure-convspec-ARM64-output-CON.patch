diff --git a/convspec/relay.c b/convspec/relay.c
index 85c884a7..5aab8696 100644
--- a/convspec/relay.c
+++ b/convspec/relay.c
@@ -756,6 +756,37 @@ static void BuildCallTo32CBClient( int isEx )
  */
 void output_asm_relays16(void)
 {
+    if (target_cpu != CPU_x86)
+    {
+        /* The 16<->32 transitions are done by the vm86 CPU emulator, which
+         * only compares the flat address of these routines; they are never
+         * executed natively. */
+        static const char * const names[] =
+        {
