From c33a58dbfb437baf72346c892a6496a0ccc0402a Mon Sep 17 00:00:00 2001
From: u <u@localhost>
Date: Sat, 7 Nov 2026 12:06:27 +0900
Subject: [PATCH] arm64: gdi: ABORTPROC thunk as NATIVE_CLOSURE, fix compile
 errors

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 gdi/gdi.c      | 76 ++++++++++++++++++++++++++++++++------------------
 gdi/metafile.c |  2 +-
 gdi/printdrv.c |  2 +-
 3 files changed, 51 insertions(+), 29 deletions(-)

diff --git a/gdi/gdi.c b/gdi/gdi.c
index a8e3dd87..84326f9e 100644
--- a/gdi/gdi.c
+++ b/gdi/gdi.c
@@ -40,6 +40,10 @@
 #define STRSAFE_NO_DEPRECATE
 #include <strsafe.h>
 
+/* krnl386 (wow_handle.c) */
+__declspec(dllimport) void SetPtr16(WORD hdl16, void *ptr, int type);
+__declspec(dllimport) void *GetPtr16(WORD hdl16, int type);
+
 #define ARRAY_SIZE(x) (sizeof(x) / sizeof((x)[0]))
 #define DIBINDEX(n) MAKELONG((n),0x10FF)
 
@@ -202,9 +206,18 @@ static BOOL is_blank_palette(HPALETTE hpal)
  * ############################################################################
  */
 
-#include <pshpack1.h>
 #define GDI_MAX_THUNKS      32
 
+#ifdef __aarch64__
+#include "wine/native_thunk.h"
+static struct gdi_thunk
+{
+    NATIVE_CLOSURE              closure;        /* calls GDI_Callback3216(pfn16, ...) */
+    DWORD                       pfn16;          /* pfn16 */
+    HDC16                       hdc;
+} *GDI_Thunks;
+#else
+#include <pshpack1.h>
 static struct gdi_thunk
 {
     BYTE                        popl_eax;       /* popl  %eax (return address) */
@@ -217,6 +230,7 @@ static struct gdi_thunk
 } *GDI_Thunks;
 
 #include <poppack.h>
+#endif
 
 /**********************************************************************
  *           GDI_Callback3216
@@ -255,12 +269,17 @@ static struct gdi_thunk* GDI_AddThunk(HDC16 dc16, ABORTPROC16 pfn16)
         }
         for (thunk = GDI_Thunks; thunk < &GDI_Thunks[GDI_MAX_THUNKS]; thunk++)
         {
+#ifdef __aarch64__
+            init_native_closure( &thunk->closure, NULL, GDI_Callback3216 );
+            thunk->pfn16        = 0;
+#else
             thunk->popl_eax     = 0x58;   /* popl  %eax */
             thunk->pushl_pfn16  = 0x68;   /* pushl pfn16 */
             thunk->pfn16        = 0;
             thunk->pushl_eax    = 0x50;   /* pushl %eax */
             thunk->jmp          = 0xe9;   /* jmp GDI_Callback3216 */
             thunk->callback     = (char *)GDI_Callback3216 - (char *)(&thunk->callback + 1);
+#endif
         }
     }
     for (thunk = GDI_Thunks; thunk < &GDI_Thunks[GDI_MAX_THUNKS]; thunk++)
@@ -269,6 +288,9 @@ static struct gdi_thunk* GDI_AddThunk(HDC16 dc16, ABORTPROC16 pfn16)
         {
             thunk->pfn16 = (DWORD)pfn16;
             thunk->hdc   = dc16;
+#ifdef __aarch64__
+            set_native_closure_data( &thunk->closure, (void *)(ULONG_PTR)thunk->pfn16 );
+#endif
             return thunk;
         }
     }
@@ -1267,9 +1289,9 @@ BOOL16 WINAPI StretchBlt16( HDC16 hdcDst, INT16 xDst, INT16 yDst,
         int countdst = GetObject(hbmpdst, sizeof(DIBSECTION), &dibdst);
         BOOL srcdib, dstdib;
 
-        if ((count == sizeof(DIBSECTION)) && (dib.dsBmih.biBitCount == 8) && !dib.dshSection && (GetPtr16(HBITMAP_16(hbmp), 1) == 0xd1b00001))
+        if ((count == sizeof(DIBSECTION)) && (dib.dsBmih.biBitCount == 8) && !dib.dshSection && ((ULONG_PTR)GetPtr16(HBITMAP_16(hbmp), 1) == 0xd1b00001))
             srcdib = TRUE;
-        if ((countdst == sizeof(DIBSECTION)) && (dibdst.dsBmih.biBitCount == 8) && !dibdst.dshSection && (GetPtr16(HBITMAP_16(hbmpdst), 1) == 0xd1b00001))
+        if ((countdst == sizeof(DIBSECTION)) && (dibdst.dsBmih.biBitCount == 8) && !dibdst.dshSection && ((ULONG_PTR)GetPtr16(HBITMAP_16(hbmpdst), 1) == 0xd1b00001))
             dstdib = TRUE;
 
         if (srcdib && (GetObjectType(hdcdst32) == OBJ_DC))
@@ -1660,7 +1682,7 @@ HGDIOBJ16 WINAPI SelectObject16( HDC16 hdc, HGDIOBJ16 handle )
     {
         DIBSECTION dib;
         int count = GetObject(handle32, sizeof(DIBSECTION), &dib);
-        if ((count == sizeof(DIBSECTION)) && (dib.dsBmih.biBitCount == 8) && !dib.dshSection && (GetPtr16(handle, 1) == 0xd1b00001))
+        if ((count == sizeof(DIBSECTION)) && (dib.dsBmih.biBitCount == 8) && !dib.dshSection && ((ULONG_PTR)GetPtr16(handle, 1) == 0xd1b00001))
             set_dib_colors(hdc32);
     }
     return HGDIOBJ_16( result );
@@ -1687,7 +1709,7 @@ HBITMAP16 WINAPI CreateBitmap16( INT16 width, INT16 height, UINT16 planes,
         HBITMAP16 ret;
         if (krnl386_get_config_int("otvdm", "DIBPalette", FALSE))
         {
-            HDC16 dc = CreateCompatibleDC16(NULL);
+            HDC16 dc = CreateCompatibleDC16(0);
             ret = CreateCompatibleBitmap16(dc, width, height);
             if (bits)
                 SetBitmapBits(HBITMAP_32(ret), width * height, bits);
@@ -1709,7 +1731,7 @@ HBITMAP16 WINAPI CreateBitmap16( INT16 width, INT16 height, UINT16 planes,
                 bmap->bmiHeader.biBitCount = 8;
                 for (int i = 0; i < 256; i++)
                     colors[i] = i;
-                SetDIBits(dc, ret, 0, height, bits, bmap, DIB_PAL_COLORS);
+                SetDIBits(dc, HBITMAP_32(ret) /* FIXME: probably ret32 */, 0, height, bits, bmap, DIB_PAL_COLORS);
                 HeapFree(GetProcessHeap(), 0, bmap);
             }
             ret = HBITMAP_16(ret32);
@@ -1730,7 +1752,7 @@ HBITMAP16 WINAPI CreateBitmap16( INT16 width, INT16 height, UINT16 planes,
             bmpinfo.bmiHeader.biHeight = -height;
             bmpinfo.bmiHeader.biPlanes = 1;
             bmpinfo.bmiHeader.biBitCount = bpp;
-            HBITMAP16 ret = CreateDIBSection16(dc16, &bmpinfo, DIB_RGB_COLORS, &bmp, NULL, NULL);
+            HBITMAP16 ret = CreateDIBSection16(dc16, &bmpinfo, DIB_RGB_COLORS, &bmp, NULL, 0);
             if (bits)
                 SetDIBits(dc, HBITMAP_32(ret), 0, height, bits, &bmpinfo, DIB_RGB_COLORS);
             ReleaseDC(NULL, dc);
@@ -1770,7 +1792,7 @@ HBRUSH16 WINAPI CreateBrushIndirect16( const LOGBRUSH16 * brush )
     brush32.lbColor = brush->lbColor;
     if (brush->lbStyle == BS_PATTERN)
     {
-        brush32.lbHatch = HBITMAP_32(brush->lbHatch);
+        brush32.lbHatch = (ULONG_PTR)HBITMAP_32(brush->lbHatch);
     }
     else
         brush32.lbHatch = brush->lbHatch;
@@ -1797,8 +1819,8 @@ HBITMAP16 WINAPI CreateCompatibleBitmap16( HDC16 hdc, INT16 width, INT16 height
         bmap->bmiHeader.biBitCount = 8;
         for (int i = 0; i < 256; i++)
             colors[i] = i;
-        ret = HBITMAP_16(CreateDIBSection(hdc32, bmap, DIB_PAL_COLORS, &section, NULL, NULL));
-        SetPtr16(ret, 0xd1b00001, 1);
+        ret = HBITMAP_16(CreateDIBSection(hdc32, bmap, DIB_PAL_COLORS, &section, NULL, 0));
+        SetPtr16(ret, (void *)0xd1b00001, 1);
         HeapFree(GetProcessHeap(), 0, bmap);
         return ret;
     }
@@ -1993,7 +2015,7 @@ HDC16 WINAPI CreateDC16( LPCSTR driver, LPCSTR device, LPCSTR output,
         return 0;
     }
     FIXME("DC driver %s not supported\n", debugstr_a(driver));
-    return CreateDC16("DIB", NULL, NULL, NULL);
+    return CreateDC16("DIB", NULL, NULL, 0);
 }
 
 
@@ -2240,10 +2262,10 @@ BOOL16 WINAPI DeleteObject16( HGDIOBJ16 obj )
     for (int i = 0; i <= STOCK_LAST + 1; i++)
         if (obj == stock[i]) return TRUE;
     if (type == OBJ_BITMAP) free_segptr_bits( obj );
-    else if ((type == OBJ_PAL) && GetPtr16(object, 1))
+    else if ((type == OBJ_PAL) && GetPtr16(LOWORD(object), 1))
     {
-        HeapFree(GetProcessHeap(), 0, GetPtr16(object, 1));
-        SetPtr16(object, NULL, 1);
+        HeapFree(GetProcessHeap(), 0, GetPtr16(LOWORD(object), 1));
+        SetPtr16(LOWORD(object), NULL, 1);
     }
     if (haxmvm_DeleteObject)
     {
@@ -2867,7 +2889,7 @@ INT16 WINAPI AddFontResource16( LPCSTR filename )
 
     if (!HIWORD(filename))
     {
-        if (!GetModuleFileName16(filename, module, MAX_PATH))
+        if (!GetModuleFileName16(LOWORD(filename), module, MAX_PATH))
             return 0;
         filename = module;
     }
@@ -2917,7 +2939,7 @@ INT16 WINAPI AddFontResource16( LPCSTR filename )
             {
                 if (mem)
                     FreeResource16(mem);
-                HRSRC16 res = FindResource16(mod, name->id, 8);
+                HRSRC16 res = FindResource16(mod, MAKEINTRESOURCEA(name->id), MAKEINTRESOURCEA(8));
                 mem = LoadResource16(mod, res);
                 font = LockResource16(mem);
                 size = SizeofResource16(mod, res);
@@ -3095,7 +3117,7 @@ BOOL16 WINAPI RemoveFontResource16( LPCSTR filename)
 
     if (!HIWORD(filename))
     {
-        if (!GetModuleFileName16(filename, module, MAX_PATH))
+        if (!GetModuleFileName16(LOWORD(filename), module, MAX_PATH))
             return 0;
         filename = module;
     }
@@ -3473,7 +3495,7 @@ UINT16 WINAPI GetOutlineTextMetrics16( HDC16 hdc, UINT16 cbData,
     int offset = sizeof(OUTLINETEXTMETRICA) - sizeof(*lpOTM);
     if (!lpOTM)
     {
-        UINT buf_size = GetOutlineTextMetricsA(hdc32, NULL, NULL);
+        UINT buf_size = GetOutlineTextMetricsA(hdc32, 0, NULL);
         if (buf_size == 0)
             return 0;
         return buf_size - offset;
@@ -3807,13 +3829,13 @@ UINT16 WINAPI GetPaletteEntries16( HPALETTE16 hpalette, UINT16 start,
     return GetPaletteEntries( HPALETTE_32(hpalette), start, count, entries );
 }
 
-static WINAPI paint_all_windows(HWND hwnd, LPARAM lparam)
+static BOOL WINAPI paint_all_windows(HWND hwnd, LPARAM lparam)
 {
     BOOL found = FALSE;
     DWORD *wndlist = (DWORD *)lparam;
     for (int j = 1; j <= wndlist[0]; j++)
     {
-        if (wndlist[j] == hwnd)
+        if (wndlist[j] == HandleToULong(hwnd))
         {
             found = TRUE;
             break;
@@ -3828,7 +3850,7 @@ BOOL update_palette(HPALETTE16 hpalette)
 {
     HPALETTE hpal32 = HPALETTE_32(hpalette);
     if (GetObjectType(hpal32) != OBJ_PAL) return;
-    DWORD *dclist = GetPtr16(hpalette, 1);
+    DWORD *dclist = (DWORD *)GetPtr16(hpalette, 1);
     DWORD *wndlist = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, (dclist[0] + 1) * 4);
     for (int i = 1; i < dclist[0]; i++)
     {
@@ -3846,7 +3868,7 @@ BOOL update_palette(HPALETTE16 hpalette)
                 BOOL found = FALSE;
                 for (int j = 1; j <= wndlist[0]; j++)
                 {
-                    if (wndlist[j] == hwnd)
+                    if (wndlist[j] == HandleToULong(hwnd))
                     {
                         found = TRUE;
                         break;
@@ -3854,7 +3876,7 @@ BOOL update_palette(HPALETTE16 hpalette)
                 }
                 if (!found)
                 {
-                    wndlist[wndlist[0] + 1] = hwnd;
+                    wndlist[wndlist[0] + 1] = HandleToULong(hwnd);
                     wndlist[0]++;
                     RedrawWindow(hwnd, NULL, NULL, RDW_INVALIDATE | RDW_UPDATENOW);
                 }
@@ -3864,13 +3886,13 @@ BOOL update_palette(HPALETTE16 hpalette)
                 DIBSECTION dib;
                 HBITMAP bitmap = GetCurrentObject(hdc32, OBJ_BITMAP);
                 int ret = GetObject(bitmap, sizeof(DIBSECTION), &dib);
-                if ((ret == sizeof(DIBSECTION)) && (dib.dsBmih.biBitCount == 8) && !dib.dshSection && (GetPtr16(HBITMAP_16(bitmap), 1) == 0xd1b00001))
+                if ((ret == sizeof(DIBSECTION)) && (dib.dsBmih.biBitCount == 8) && !dib.dshSection && ((ULONG_PTR)GetPtr16(HBITMAP_16(bitmap), 1) == 0xd1b00001))
                     set_dib_colors(hdc32);
             }
         }
     }
     if (krnl386_get_config_int("otvdm", "DIBPalette", FALSE) && (hpal32 == get_realized_palette()))
-        EnumThreadWindows(GetCurrentThreadId(), paint_all_windows, wndlist);
+        EnumThreadWindows(GetCurrentThreadId(), paint_all_windows, (LPARAM)wndlist);
     HeapFree(GetProcessHeap(), 0, wndlist);
 }
 
@@ -3984,7 +4006,7 @@ HDC16 WINAPI ResetDC16( HDC16 hdc, const DEVMODEA *devmode )
 {
     DEVMODEA dma = {0};
     if (!IsValidDevmodeA(devmode, devmode->dmSize + devmode->dmDriverExtra))
-        return NULL;
