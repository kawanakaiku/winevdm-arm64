Subject: [PATCH 15/27] arm64: winhlp32: fix compile errors, comp_TTLBTree
 returns int

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 winhlp32/hlpfile.c |  4 ++--
 winhlp32/hlpfile.h |  1 +
 winhlp32/winhelp.c | 37 +++++++++++++++++++------------------
 3 files changed, 22 insertions(+), 20 deletions(-)

diff --git a/winhlp32/hlpfile.c b/winhlp32/hlpfile.c
index fd5bdbfc..716b5641 100644
--- a/winhlp32/hlpfile.c
+++ b/winhlp32/hlpfile.c
@@ -2433,13 +2433,13 @@ static BOOL HLPFILE_SystemCommands(HLPFILE* hlpfile)
     if ((hlpfile->charset != DEFAULT_CHARSET) && (hlpfile->charset != ANSI_CHARSET))
     {
         CHARSETINFO info;
-        TranslateCharsetInfo(hlpfile->charset, &info, TCI_SRCCHARSET);
+        TranslateCharsetInfo((DWORD *)(DWORD_PTR)hlpfile->charset, &info, TCI_SRCCHARSET);
         hlpfile->codepage = info.ciACP;
     }
     else if (lcid)
     {
         CHARSETINFO info;
-        if (TranslateCharsetInfo(lcid, &info, TCI_SRCLOCALE))
+        if (TranslateCharsetInfo((DWORD *)(DWORD_PTR)lcid, &info, TCI_SRCLOCALE))
         {
             hlpfile->codepage = info.ciACP;
             hlpfile->charset = info.ciCharset;
