From 0f591c7365e58e412afd20841a3130741dde0530 Mon Sep 17 00:00:00 2001
From: u <u@example.com>
Date: Sat, 7 Nov 2026 12:06:21 +0900
Subject: [PATCH] arm64: msvideo: 16-bit ICCOMPRESS/ICDECOMPRESS/ICDRAW
 layouts, NATIVE_CLOSURE driver thunks, widened lParam slots

---
 msvideo/msvideo16.c | 189 ++++++++++++++++++++++++++------------------
 msvideo/vfw16.h     |  68 ++++++++++++----
 2 files changed, 165 insertions(+), 92 deletions(-)

diff --git a/msvideo/msvideo16.c b/msvideo/msvideo16.c
index e51b615a..117bed14 100644
--- a/msvideo/msvideo16.c
+++ b/msvideo/msvideo16.c
@@ -20,6 +20,10 @@
  */
 
