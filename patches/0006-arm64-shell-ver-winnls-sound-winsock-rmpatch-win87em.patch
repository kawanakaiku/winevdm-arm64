From 527e55c249bb788635f1de4dd007d47214579f5e Mon Sep 17 00:00:00 2001
From: u <u@example.com>
Date: Sat, 7 Nov 2026 10:03:13 +0900
Subject: [PATCH] arm64: shell/ver/winnls/sound/winsock/rmpatch/win87em: fix
 conversions and prototypes

---
 rmpatch/instr.c   |  4 +++-
 rmpatch/rmpatch.c |  7 +++++--
 shell/shell.c     | 21 +++++++++++----------
 sound/sound.c     |  6 +++---
 ver/version.c     | 10 +++++-----
 win87em/win87em.c |  3 +++
 winnls/winnls.c   |  7 +++----
 winsock/socket.c  |  6 +++++-
 8 files changed, 38 insertions(+), 26 deletions(-)

diff --git a/rmpatch/instr.c b/rmpatch/instr.c
index 2fdf2e26..e88bdda1 100644
--- a/rmpatch/instr.c
+++ b/rmpatch/instr.c
@@ -32,6 +32,8 @@
 #define SET_LOBYTE(dw,val)  ((dw) = ((dw) & 0xffffff00) | LOBYTE(val))
 #define ADD_LOWORD(dw,val)  ((dw) = ((dw) & 0xffff0000) | LOWORD((DWORD)(dw)+(val)))
 
+/* ARM64: declared in krnl386 (dosexe.h is not included here); needs a prototype */
+__declspec(dllimport) void DOSVM_start_bios_timer(void);
 static WORD dosmem_0040H = 0; 
 static WORD dosmem_0000H = 0;
 
@@ -608,7 +610,7 @@ BOOL rmpatch_emulate_instruction(CONTEXT86 *context)
                 // this is a standard pattern for MSC _int86
                 if (*(WORD *)(addr + 2) != context->SegSs)
                     break;
-                static WORD stackcode = NULL;
+                static WORD stackcode = 0;
                 if (!stackcode)
                     stackcode = AllocDStoCSAlias16(context->SegSs);
                 *(WORD *)(addr + 2) = stackcode;
diff --git a/rmpatch/rmpatch.c b/rmpatch/rmpatch.c
index eae67108..52416a23 100644
--- a/rmpatch/rmpatch.c
+++ b/rmpatch/rmpatch.c
@@ -101,6 +101,9 @@ struct stkframe
 };
 #include <poppack.h>
 
+BOOL rmpatch_emulate_instruction(CONTEXT86 *context);
+static HINSTANCE16 hToolhelp16;
+
 void WINAPI intcb(CONTEXT86 *context)
 {
 	struct stkframe *frame = MapSL(MAKESEGPTR(context->SegSs, context->Esp));
@@ -124,14 +127,14 @@ BOOL WINAPI DllEntryPoint(DWORD fdwReason, HINSTANCE16 hinstDLL, WORD ds,
 	switch(fdwReason)
 	{
 	case DLL_PROCESS_ATTACH:
-		LoadLibrary16("TOOLHELP");
+		hToolhelp16 = LoadLibrary16("TOOLHELP");
 		InterruptRegister16(FAKE_HTASK16, GetProcAddress16(GetModuleHandle16("RMPATCH"), "intcb"));
 		NotifyRegister16(FAKE_HTASK16, GetProcAddress16(GetModuleHandle16("RMPATCH"), "checkpatch"), 0 /*NF_NORMAL*/);
 		break;
 	case DLL_PROCESS_DETACH:
 		InterruptUnRegister16(FAKE_HTASK16);
 		NotifyUnRegister16(FAKE_HTASK16);
-		FreeLibrary16("TOOLHELP");
+		FreeLibrary16(hToolhelp16);
 		break;
 	}
 	return TRUE;
diff --git a/shell/shell.c b/shell/shell.c
index 80b61931..27f08a7a 100644
--- a/shell/shell.c
+++ b/shell/shell.c
@@ -263,7 +263,8 @@ BOOL16 WINAPI ShellAbout16( HWND16 hWnd, LPCSTR szApp, LPCSTR szOtherStuff, HICO
 }
 
 
-__declspec(dllimport) HICON NE_ExtractIcon(LPCSTR lpszExeFileName,
+/* ARM64: actually returns a count/UINT (see krnl386/resource.c) */
+__declspec(dllimport) UINT NE_ExtractIcon(LPCSTR lpszExeFileName,
 	HICON * RetPtr,
 	INT nIconIndex,
 	UINT nIcons,
@@ -281,7 +282,7 @@ static inline UINT PrivateExtractIconsNE(
 	UINT nIcons,    /* [in] number of icons to retrieve */
 	UINT flags)    /* [in] LR_* flags used by LoadImage */
 {
-	HICON ret;
+	UINT ret;
 	return (ret = PrivateExtractIconsA(lpwstrFile, nIndex, sizeX, sizeY, phicon, pIconId, nIcons, flags))
 		? ret : NE_ExtractIcon(lpwstrFile, phicon, nIndex, nIcons, sizeX, sizeY, pIconId, flags);
 }
@@ -374,7 +375,7 @@ HICON16 WINAPI ExtractIcon16( HINSTANCE16 hInstance, LPCSTR lpszExeFileName,
     lpszExeFileName = RedirectSystemDir(lpszExeFileName, buf, MAX_PATH);
     if (nIconIndex == 0xFFFF)
     {
-	    return ExtractIconNE(NULL, lpszExeFileName, -1);
+	    return (HICON16)(ULONG_PTR)ExtractIconNE(NULL, lpszExeFileName, -1);
     }
     return convert_icon_to_16( hInstance, ExtractIconNE(NULL, lpszExeFileName, nIconIndex) );
 }
@@ -417,21 +418,21 @@ UINT16 WINAPI ExtractIconEx16(
 * Return icon for given file (either from file itself or from associated
 * executable) and patch parameters if needed.
 */
-HICON16 WINAPI ExtractAssociatedIconNE(HINSTANCE hInst, LPSTR lpIconPath, LPWORD lpiIcon)
+HICON16 WINAPI ExtractAssociatedIconNE(HINSTANCE16 hInst, LPSTR lpIconPath, LPWORD lpiIcon)
 {
-	HICON hIcon = NULL;
+	HICON16 hIcon = 0;
 	WORD wDummyIcon = 0;
 
-	TRACE("%p %s %p\n", hInst, debugstr_a(lpIconPath), lpiIcon);
+	TRACE("%04x %s %p\n", hInst, debugstr_a(lpIconPath), lpiIcon);
 
 	if (lpiIcon == NULL)
 		lpiIcon = &wDummyIcon;
 
 	hIcon = ExtractIcon16(hInst, lpIconPath, *lpiIcon);
 
-	if (hIcon < (HICON)2)
+	if (hIcon < 2)
 	{
-		return convert_icon_to_16(hInst, ExtractAssociatedIconA(hInst, lpIconPath, lpiIcon));
+		return convert_icon_to_16(hInst, ExtractAssociatedIconA(NULL /* hInst was always NULL */, lpIconPath, lpiIcon));
 	}
 	return hIcon;
 }
@@ -443,7 +444,7 @@ HICON16 WINAPI ExtractAssociatedIconNE(HINSTANCE hInst, LPSTR lpIconPath, LPWORD
  */
 HICON16 WINAPI ExtractAssociatedIcon16(HINSTANCE16 hInst, LPSTR lpIconPath, LPWORD lpiIcon)
 {
-    return ExtractAssociatedIconNE(NULL, lpIconPath, lpiIcon);
+    return ExtractAssociatedIconNE(0, lpIconPath, lpiIcon);
 }
 
 /*************************************************************************
@@ -730,7 +731,7 @@ HINSTANCE16 WINAPI ShellExecute16( HWND16 hWnd, LPCSTR lpOperation,
     }
     if (rret1632 == ERROR_FILE_NOT_FOUND)
     {
-        return rret1632;
+        return (HINSTANCE16)(ULONG_PTR)rret1632;
     }
 	HINSTANCE rret = ShellExecuteA(HWND_32(hWnd), lpOperation, lpFile, lpParameters,
 		lpDirectory, iShowCmd);
