diff --git a/wine/wine/native_thunk.h b/wine/wine/native_thunk.h
new file mode 100644
index 00000000..89656c53
--- /dev/null
+++ b/wine/wine/native_thunk.h
@@ -0,0 +1,48 @@
+/*
+ * Small native code stubs ("closures") called by the 32/64-bit side,
+ * for example a TIMERPROC or a WNDPROC that has to reach a 16-bit
+ * procedure.  The stub inserts 'data' as the first argument and jumps
+ * to 'func', so 'func' receives (data, original arguments...).
+ *
+ * i386 builds keep their own hand written x86 thunks; this header is
+ * used on ARM64, where at most 7 original register arguments are kept
+ * (x0-x6 move to x1-x7; stack arguments are passed through unchanged).
+ */
+#ifndef __WINE_NATIVE_THUNK_H
+#define __WINE_NATIVE_THUNK_H
+
+#include <windef.h>
+#include <winbase.h>
+
+#ifdef __aarch64__
+
+typedef struct
+{
+    DWORD code[10];
+    void *data;   /* code + 40 */
+    void *func;   /* code + 48 */
+} NATIVE_CLOSURE;
+
+static inline void init_native_closure( NATIVE_CLOSURE *c, void *data, void *func )
+{
+    int i;
+    /* mov x7, x6 ... mov x1, x0 */
+    for (i = 0; i < 7; i++)
+        c->code[i] = 0xaa0003e0 | ((6 - i) << 16) | (7 - i);
+    c->code[7] = 0x58000000 | (((40 - 7 * 4) / 4) << 5) | 0;   /* ldr x0, data */
+    c->code[8] = 0x58000000 | (((48 - 8 * 4) / 4) << 5) | 16;  /* ldr x16, func */
+    c->code[9] = 0xd61f0200;                                   /* br x16 */
+    c->data = data;
+    c->func = func;
+    FlushInstructionCache( GetCurrentProcess(), c, sizeof(*c) );
+}
+
+/* only update the target data of an existing closure */
+static inline void set_native_closure_data( NATIVE_CLOSURE *c, void *data )
+{
+    c->data = data;
+}
+
+#endif /* __aarch64__ */
+
+#endif /* __WINE_NATIVE_THUNK_H */
