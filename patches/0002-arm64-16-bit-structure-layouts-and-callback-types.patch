From 3d70aaa6b10dc007b68feb9422be38b995917d18 Mon Sep 17 00:00:00 2001
From: u <u@localhost>
Date: Sat, 7 Nov 2026 09:57:51 +0900
Subject: [PATCH] arm64: 16-bit structure layouts and callback types

- 16-bit callback 'function pointer' types are SEGPTR on 64-bit hosts.
- LPARAM16/LRESULT16 for the 32-bit LPARAM/LRESULT fields of 16-bit
  structures; pointer fields that hold 16:16 values become SEGPTR.
- ENTRYPOINT16/CALLFROM16/STACK16FRAME hold 32-bit flat addresses,
  TDB keeps its layout (8-byte teb, 32-bit event handle).
- Add wine/native_thunk.h: ARM64 closure stubs replacing the x86
  thunks that are called by the native side.
- winecrt0: the setjmp based exception support is not needed with
  compiler exceptions.
---
 CMakeLists.txt             |  5 +++-
 commdlg/cdlg16.h           | 34 +++++++++++++++++++----
 krnl386/kernel16_private.h | 18 ++++++++++++
 msvideo/vfw16.h            | 20 ++++++++++++++
 toolhelp/toolhelp.h        |  8 ++++++
 wine/wine/exception.h      |  1 +
 wine/wine/mmsystem16.h     | 36 ++++++++++++++++++++++++
 wine/wine/native_thunk.h   | 48 ++++++++++++++++++++++++++++++++
 wine/wine/server.h         |  2 ++
 wine/wine/winbase16.h      | 12 ++++++++
 wine/wine/windef16.h       | 56 ++++++++++++++++++++++++++++++++++++++
 wine/wine/wingdi16.h       | 20 ++++++++++++++
 wine/wine/winuser16.h      | 24 ++++++++++------
 winecrt0/exception.c       |  2 +-
 winnls/winnls.c            |  6 ++--
 15 files changed, 274 insertions(+), 18 deletions(-)
 create mode 100644 wine/wine/native_thunk.h

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f9a91fb2..b1ea78f3 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -23,7 +23,10 @@ if (WINEVDM_ARM64)
     set(CONVSPEC_ARCH --arm64)
     if (NOT(MSVC))
         add_definitions(-DUSE_COMPILER_EXCEPTIONS)
-        string(APPEND CMAKE_C_FLAGS " -fms-extensions -Wno-int-to-pointer-cast -Wno-pointer-to-int-cast")
+        # the sources were written for MSVC: keep pointer/integer mixups and
+        # implicit declarations as errors (they truncate 64-bit pointers),
+        # but not the type mismatches between same-size pointers
+        string(APPEND CMAKE_C_FLAGS " -fms-extensions -Wno-int-to-pointer-cast -Wno-pointer-to-int-cast -Wno-error=incompatible-pointer-types -Wno-error=return-mismatch -Wno-error=incompatible-function-pointer-types")
         string(APPEND CMAKE_CXX_FLAGS " -fms-extensions")
         # keep every image below 4GB: 16-bit code holds 32-bit flat pointers
         # to 32-bit side functions (relay entry points, thunks, window procs)
