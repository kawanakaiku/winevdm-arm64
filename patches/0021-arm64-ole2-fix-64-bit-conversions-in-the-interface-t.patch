     {
-        hr = IStream16_Write(pstm, tmpBuffer, bytesRead, MapLS(&bytesWritten));
+        SEGPTR segbuf = MapLS(tmpBuffer), segwritten = MapLS(&bytesWritten);
+        hr = IStream16_Write(pstm, segbuf, bytesRead, segwritten);
+        UnMapLS(segbuf);
+        UnMapLS(segwritten);
